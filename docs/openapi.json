{
  "components": {
    "schemas": {
      "AuthenticationRequest": {
        "properties": {
          "identifier": {
            "description": "An Iranian mobile number: Persian or Latin digits, spaces, +98/0098/98 or a leading 0. 'identifier' kept as the field name for one release so an older client sending 'phone'-shaped values here keeps working.",
            "examples": [
              "0912 345 6789"
            ],
            "maxLength": 32,
            "minLength": 3,
            "title": "Identifier",
            "type": "string"
          }
        },
        "required": [
          "identifier"
        ],
        "title": "AuthenticationRequest",
        "type": "object"
      },
      "AuthenticationRequested": {
        "properties": {
          "code_length": {
            "title": "Code Length",
            "type": "integer"
          },
          "expires_in_seconds": {
            "description": "How long the code stays valid.",
            "title": "Expires In Seconds",
            "type": "integer"
          },
          "resend_after_seconds": {
            "description": "Seconds to wait before POSTing /auth/request again.",
            "title": "Resend After Seconds",
            "type": "integer"
          }
        },
        "required": [
          "resend_after_seconds",
          "expires_in_seconds",
          "code_length"
        ],
        "title": "AuthenticationRequested",
        "type": "object"
      },
      "AuthenticationVerification": {
        "properties": {
          "code": {
            "maxLength": 6,
            "minLength": 6,
            "pattern": "^\\d{6}$",
            "title": "Code",
            "type": "string"
          },
          "identifier": {
            "examples": [
              "0912 345 6789"
            ],
            "maxLength": 32,
            "minLength": 3,
            "title": "Identifier",
            "type": "string"
          }
        },
        "required": [
          "identifier",
          "code"
        ],
        "title": "AuthenticationVerification",
        "type": "object"
      },
      "ConfigLimits": {
        "properties": {
          "scans_per_day": {
            "title": "Scans Per Day",
            "type": "integer"
          }
        },
        "required": [
          "scans_per_day"
        ],
        "title": "ConfigLimits",
        "type": "object"
      },
      "ConfigResponse": {
        "properties": {
          "day_ends_at": {
            "format": "date-time",
            "title": "Day Ends At",
            "type": "string"
          },
          "day_key": {
            "title": "Day Key",
            "type": "string"
          },
          "limits": {
            "$ref": "#/components/schemas/ConfigLimits"
          },
          "nickname": {
            "$ref": "#/components/schemas/NicknameLimits"
          },
          "server_time": {
            "format": "date-time",
            "title": "Server Time",
            "type": "string"
          },
          "terms_version": {
            "title": "Terms Version",
            "type": "string"
          },
          "timezone": {
            "title": "Timezone",
            "type": "string"
          },
          "venues": {
            "items": {
              "$ref": "#/components/schemas/VenueResponse"
            },
            "title": "Venues",
            "type": "array"
          },
          "week_ends_at": {
            "format": "date-time",
            "title": "Week Ends At",
            "type": "string"
          },
          "week_key": {
            "title": "Week Key",
            "type": "string"
          }
        },
        "required": [
          "server_time",
          "timezone",
          "day_key",
          "week_key",
          "day_ends_at",
          "week_ends_at",
          "terms_version",
          "limits",
          "nickname",
          "venues"
        ],
        "title": "ConfigResponse",
        "type": "object"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "examples": [
              "CODE_MISTYPED"
            ],
            "title": "Code",
            "type": "string"
          },
          "message": {
            "examples": [
              "One character looks mistyped; check the code."
            ],
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The shape of every error body; see docs/API_CONTRACT.md#errors.\n\n``responses={...}`` on a route should reference this model so /docs and\nthe generated OpenAPI schema show the real envelope, not FastAPI's\ndefault ``{\"detail\": \"...\"}``.",
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "LedgerEntryResponse": {
        "properties": {
          "amount": {
            "title": "Amount",
            "type": "integer"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "reason": {
            "title": "Reason",
            "type": "string"
          }
        },
        "required": [
          "id",
          "amount",
          "reason",
          "created_at"
        ],
        "title": "LedgerEntryResponse",
        "type": "object"
      },
      "NicknameLimits": {
        "properties": {
          "max_length": {
            "title": "Max Length",
            "type": "integer"
          },
          "min_length": {
            "title": "Min Length",
            "type": "integer"
          }
        },
        "required": [
          "min_length",
          "max_length"
        ],
        "title": "NicknameLimits",
        "type": "object"
      },
      "PassportProgressResponse": {
        "properties": {
          "campaign": {
            "title": "Campaign",
            "type": "string"
          },
          "points": {
            "title": "Points",
            "type": "integer"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "campaign",
          "points",
          "updated_at"
        ],
        "title": "PassportProgressResponse",
        "type": "object"
      },
      "RedeemCodeRequest": {
        "description": "Raw user input or the code from the QR URL; the server normalizes it.",
        "properties": {
          "code": {
            "examples": [
              "TO-7KQ2-M9XH-4R6"
            ],
            "maxLength": 64,
            "minLength": 1,
            "title": "Code",
            "type": "string"
          }
        },
        "required": [
          "code"
        ],
        "title": "RedeemCodeRequest",
        "type": "object"
      },
      "RedemptionResponse": {
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "city_entries": {
            "title": "City Entries",
            "type": "integer"
          },
          "coin_balance": {
            "title": "Coin Balance",
            "type": "integer"
          },
          "coins_awarded": {
            "title": "Coins Awarded",
            "type": "integer"
          },
          "entries_added": {
            "title": "Entries Added",
            "type": "integer"
          },
          "replayed": {
            "title": "Replayed",
            "type": "boolean"
          }
        },
        "required": [
          "city",
          "entries_added",
          "city_entries",
          "coins_awarded",
          "coin_balance",
          "replayed"
        ],
        "title": "RedemptionResponse",
        "type": "object"
      },
      "UserPageResponse": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/UserResponse"
            },
            "title": "Items",
            "type": "array"
          },
          "next_cursor": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Pass as ``cursor`` for the next page; null on the last page.",
            "title": "Next Cursor"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ],
        "title": "UserPageResponse",
        "type": "object"
      },
      "UserResponse": {
        "properties": {
          "account_status": {
            "title": "Account Status",
            "type": "string"
          },
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "home_venue_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Home Venue Id"
          },
          "id": {
            "format": "uuid",
            "title": "Id",
            "type": "string"
          },
          "identifier": {
            "title": "Identifier",
            "type": "string"
          },
          "nickname": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Nickname"
          },
          "profile_complete": {
            "title": "Profile Complete",
            "type": "boolean"
          },
          "role": {
            "title": "Role",
            "type": "string"
          },
          "terms_accepted": {
            "title": "Terms Accepted",
            "type": "boolean"
          },
          "updated_at": {
            "format": "date-time",
            "title": "Updated At",
            "type": "string"
          },
          "verification_status": {
            "title": "Verification Status",
            "type": "string"
          }
        },
        "required": [
          "id",
          "identifier",
          "display_name",
          "nickname",
          "home_venue_id",
          "terms_accepted",
          "profile_complete",
          "account_status",
          "verification_status",
          "role",
          "created_at",
          "updated_at"
        ],
        "title": "UserResponse",
        "type": "object"
      },
      "UserUpdate": {
        "description": "Every field is optional; only the ones sent are changed.",
        "properties": {
          "accept_terms_version": {
            "anyOf": [
              {
                "maxLength": 20,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Must equal ``terms_version``.",
            "title": "Accept Terms Version"
          },
          "display_name": {
            "anyOf": [
              {
                "maxLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "home_venue_id": {
            "anyOf": [
              {
                "maxLength": 40,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "An ``id`` from ``GET /config`` ``venues``.",
            "title": "Home Venue Id"
          },
          "nickname": {
            "anyOf": [
              {
                "maxLength": 64,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "3-16 characters; rules in docs/SECURITY.md.",
            "title": "Nickname"
          }
        },
        "title": "UserUpdate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VenueResponse": {
        "properties": {
          "city": {
            "title": "City",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "name": {
            "title": "Name",
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "city"
        ],
        "title": "VenueResponse",
        "type": "object"
      },
      "WalletResponse": {
        "properties": {
          "balance": {
            "title": "Balance",
            "type": "integer"
          },
          "lifetime_earned": {
            "title": "Lifetime Earned",
            "type": "integer"
          },
          "recent": {
            "items": {
              "$ref": "#/components/schemas/LedgerEntryResponse"
            },
            "title": "Recent",
            "type": "array"
          }
        },
        "required": [
          "balance",
          "lifetime_earned",
          "recent"
        ],
        "title": "WalletResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "Session Cookie": {
        "in": "cookie",
        "name": "lottery_passport_session",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "Backend for the TorshX x Oxin campaign passport. The contract is docs/API_CONTRACT.md; if this schema and that file disagree about a live endpoint, the contract wins and it is a bug here.",
    "title": "Lottery Passport API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/admin/users": {
      "get": {
        "description": "Newest first, keyset-paginated. Pass the previous response's ``next_cursor`` as ``cursor``; ``next_cursor`` is null on the last page.",
        "operationId": "list_users",
        "parameters": [
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 50,
              "maximum": 100,
              "minimum": 1,
              "title": "Limit",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Cursor"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserPageResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "400": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "CURSOR_INVALID"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "AUTH_REQUIRED"
          },
          "403": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "ADMIN_REQUIRED"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "Session Cookie": []
          }
        ],
        "summary": "List users (admin)",
        "tags": [
          "admin"
        ]
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "description": "Clears the session cookie; always 204, even with no session.",
        "operationId": "logout",
        "responses": {
          "204": {
            "description": "Successful Response"
          }
        },
        "security": [
          {
            "Session Cookie": []
          }
        ],
        "summary": "End the current session",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/request": {
      "post": {
        "description": "Accepts Persian or Latin digits, spaces, +98/0098/98 or a leading 0. The response is the same shape for a new and a known number.",
        "operationId": "request_authentication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthenticationRequested"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "PHONE_INVALID"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "OTP_COOLDOWN or OTP_DAILY_LIMIT"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "SMS delivery is unavailable"
          }
        },
        "summary": "Request a sign-in code",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "description": "The first successful verify creates the account. Sets the session cookie on success (see docs/API_CONTRACT.md#hosts-cors-and-cookies).",
        "operationId": "verify_authentication",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthenticationVerification"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "OTP_INVALID"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Verify a sign-in code",
        "tags": [
          "authentication"
        ]
      }
    },
    "/api/v1/config": {
      "get": {
        "description": "No sign-in needed. Server time, the Tehran day and week keys and the limits clients must use instead of the phone clock, and the active lounges for the profile picker. Avatar/game catalogues are not included yet.",
        "operationId": "get_config",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConfigResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Client configuration",
        "tags": [
          "config"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "get_me",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "security": [
          {
            "Session Cookie": []
          }
        ],
        "summary": "The signed-in user",
        "tags": [
          "users"
        ]
      },
      "patch": {
        "description": "Send any of ``display_name``, ``nickname``, ``accept_terms_version`` and ``home_venue_id``; only the fields sent change. ``profile_complete`` becomes true once a nickname is set and the terms are accepted.",
        "operationId": "update_me",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserUpdate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NICKNAME_TAKEN"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "NICKNAME_INVALID, TERMS_VERSION_INVALID or CATALOGUE_UNKNOWN"
          }
        },
        "security": [
          {
            "Session Cookie": []
          }
        ],
        "summary": "Update the signed-in user",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/passports": {
      "get": {
        "description": "Parked for the MVP (ADR 0009): kept out of the player-facing contract but still tracked.",
        "operationId": "get_my_passports",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PassportProgressResponse"
                  },
                  "title": "Response Get My Passports",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Not signed in"
          }
        },
        "security": [
          {
            "Session Cookie": []
          }
        ],
        "summary": "Per-city passport progress",
        "tags": [
          "users"
        ]
      }
    },
    "/api/v1/me/wallet": {
      "get": {
        "operationId": "get_my_wallet",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/WalletResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
