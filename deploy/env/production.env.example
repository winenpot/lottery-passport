# Production: <base>=/opt/lottery-passport, deploy user `deploy`.
# Placeholders in <angle brackets>; generate secrets ON the server, never print them:
#   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# Mode 600, owner = the deploy user. Never committed.

# --- stack (deploy/compose.yml interpolation) ---------------------------------
LP_IMAGE_REPO=ghcr.io/winenpot/lottery-passport
POSTGRES_DB=lottery_passport
POSTGRES_USER=lottery_passport
POSTGRES_PASSWORD=<generated>
# Compose network; must not overlap any other Docker network on the host.
LP_SUBNET=10.200.98.0/24
HTTP_PUBLISH=0.0.0.0:80
HTTPS_PUBLISH=0.0.0.0:443
API_WORKERS=4
API_MEM_LIMIT=2g
PG_MEM_LIMIT=4g
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=5GB

# --- app (app/core/config.py) ---------------------------------------------------
ENVIRONMENT=production
DATABASE_URL=postgresql+asyncpg://lottery_passport:<same as POSTGRES_PASSWORD>@postgres:5432/lottery_passport
FORWARDED_ALLOW_IPS=*
LOG_JSON=true
LOG_LEVEL=INFO
# Generated on the server, copied ONCE into the password manager (two holders).
# Never changes after codes are printed.
REDEMPTION_CODE_PEPPER=<generated>
ADMIN_SESSION_SECRET=<generated>
PUBLIC_APP_ORIGIN=https://play.torshx.com
CORS_ORIGINS=["https://play.torshx.com"]
SESSION_COOKIE_SAMESITE=lax
# TERMS_REQUIRED, OTP_TEST_NUMBERS, OTP_ALLOWED_PHONES: leave unset (the app
# refuses the test values in production).
KAVENEGAR_OTP_API_KEY=<paste on the server>
KAVENEGAR_TEMPLATE_LOGIN=login
KAVENEGAR_TEMPLATE_SIGNUP=signup
