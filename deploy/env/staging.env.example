# Staging on atpg: <base>=/home/data/lottery-passport, deploy user `data`.
# Placeholders in <angle brackets>; generate secrets ON the server, never print them:
#   openssl rand -base64 48 | tr -d '\n/+=' | cut -c1-48
# Mode 600, owner = the deploy user. Never committed.

# --- stack (deploy/compose.yml interpolation) ---------------------------------
LP_IMAGE_REPO=ghcr.io/winenpot/lottery-passport
POSTGRES_DB=lottery_passport
POSTGRES_USER=lottery_passport
POSTGRES_PASSWORD=<generated>
# Compose network; must not overlap any other Docker network on the host.
LP_SUBNET=10.200.98.0/24
HTTP_PUBLISH=0.0.0.0:8098
API_WORKERS=1
API_MEM_LIMIT=256m
# Minimal footprint (L0', 2026-10-19): staging rehearses production's
# behavior, not its scale, and shares atpg with 30+ other containers.
PG_MEM_LIMIT=384m
PG_SHARED_BUFFERS=32MB
PG_EFFECTIVE_CACHE_SIZE=128MB
# 1 worker x 15 pool (SQLAlchemy default 5 + 10) + alembic + one-off scripts.
PG_MAX_CONNECTIONS=25
PG_WORK_MEM=2MB
NGINX_MEM_LIMIT=64m

# --- app (app/core/config.py) ---------------------------------------------------
ENVIRONMENT=staging
DATABASE_URL=postgresql+asyncpg://lottery_passport:<same as POSTGRES_PASSWORD>@postgres:5432/lottery_passport
FORWARDED_ALLOW_IPS=*
LOG_JSON=true
LOG_LEVEL=INFO
REDEMPTION_CODE_PEPPER=<generated; staging only, never used for printing>
ADMIN_SESSION_SECRET=<generated>
PUBLIC_APP_ORIGIN=https://staging.torshx.com
CORS_ORIGINS=["https://staging.torshx.com"]
SESSION_COOKIE_SAMESITE=lax
# Test conveniences, staging only (production refuses them):
TERMS_REQUIRED=false
OTP_TEST_NUMBERS=true
OTP_ALLOWED_PHONES=<team numbers, comma-separated>
KAVENEGAR_OTP_API_KEY=<paste on the server; empty = codes only in the logs>
KAVENEGAR_TEMPLATE_LOGIN=login
KAVENEGAR_TEMPLATE_SIGNUP=signup
