# Copy to <base>/site/alert.env on the server, chmod 600. Read by deploy/alert_check.sh.
# Comma-separated Iranian mobiles that get the alert texts.
ALERT_PHONES=09120000000
# An APPROVED Kavenegar verify/lookup template with a %token (alert name goes there).
ALERT_TEMPLATE=otp
PUBLIC_URL=https://play.torshx.com
DISK_MAX_PERCENT=85
# backup.sh runs every 6 hours: 7 hours without a "backup ok" line is stale.
BACKUP_MAX_AGE_MINUTES=420
CREDIT_MIN_RIALS=500000
REMIND_MINUTES=120
# Daily "AlertsAlive<N>failing" text at this UTC time (05:30 = 09:00 Tehran); empty = off.
DAILY_OK_UTC=05:30
