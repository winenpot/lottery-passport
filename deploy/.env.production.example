# Copy to deploy/.env on the server: chmod 600 .env ; chown root:root .env
# Every value marked CHANGE is a secret: generate it, store it in the password
# manager, never paste it in chat or email.

ENVIRONMENT=production
APP_NAME=Lottery Passport API
LOG_LEVEL=INFO
LOG_JSON=true

# Docker Compose itself
COMPOSE_PROFILES=
PIP_INDEX_URL=https://pypi.org/simple

# PostgreSQL (the API reaches it by the Compose service name "postgres")
POSTGRES_DB=lottery_passport
POSTGRES_USER=lottery_passport
POSTGRES_PASSWORD=CHANGE
DATABASE_URL=postgresql+asyncpg://lottery_passport:CHANGE@postgres:5432/lottery_passport
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000

# Secrets (python -c "import secrets; print(secrets.token_urlsafe(48))")
API_KEY=CHANGE
# The pepper must never change after the first batch is printed.
REDEMPTION_CODE_PEPPER=CHANGE

# Game rules
REDEMPTION_DAILY_LIMIT_PER_USER=20
CAMPAIGN_TIMEZONE=Asia/Tehran

# Sessions and sign-in (__Host- prefix: Secure, Path=/, no Domain; not for plain-http dev)
SESSION_COOKIE_NAME=__Host-lp_session
AUTH_CHALLENGE_TTL_SECONDS=150
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_MAX_VERIFICATION_ATTEMPTS=5
EMAIL_PROVIDER=unconfigured

# Same origin in production; keep the exact public origin here.
CORS_ORIGINS=["https://play.example.ir"]

# nginx enforces per-IP limits; this in-process limiter is only a high backstop
# (each of the 4 workers counts separately, and lounges share one IP).
RATE_LIMIT_REQUESTS=600
RATE_LIMIT_WINDOW_SECONDS=60
FORWARDED_ALLOW_IPS=*
