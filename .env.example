APP_NAME=Lottery Passport API
ENVIRONMENT=development
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
API_KEY=
EMAIL_PROVIDER=development
AUTH_CHALLENGE_TTL_SECONDS=600
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_MAX_VERIFICATION_ATTEMPTS=5
SESSION_COOKIE_NAME=lottery_passport_session
LOG_LEVEL=INFO
LOG_JSON=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/lottery_passport
DB_CONNECT_TIMEOUT_SECONDS=5
CORS_ORIGINS=["http://localhost:3000"]