APP_NAME=Lottery Passport API
ENVIRONMENT=development
# Deployed commit shown by GET /health (the CI image build sets it).
# GIT_COMMIT=
PORT=8000
FORWARDED_ALLOW_IPS=127.0.0.1
# 32+ random characters; generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit it, never change it after codes are printed (all hashes depend on it).
REDEMPTION_CODE_PEPPER=
# Signs the /admin panel cookie (32+ chars; required in staging/production).
# Unset: a random key per process, so admin sessions end on restart.
ADMIN_SESSION_SECRET=
ADMIN_SESSION_MAX_AGE_SECONDS=3600
# Encrypts the admin TOTP secret at rest (32+ chars; required in staging/production).
# Unset: a random key per process, so any pending/confirmed secret is unreadable
# after a restart. TOTP itself is opt-in per admin, set up at /admin/security/totp.
ADMIN_TOTP_ENCRYPTION_KEY=
REDEMPTION_DAILY_LIMIT_PER_USER=20
CAMPAIGN_TIMEZONE=Asia/Tehran
AUTH_SESSION_TTL_SECONDS=2592000
SESSION_COOKIE_NAME=lottery_passport_session
LOG_LEVEL=INFO
LOG_JSON=true
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60
# Matches the postgres service in docker-compose.yml (README quick start).
DATABASE_URL=postgresql+asyncpg://lottery_passport:local_development_only@localhost:5432/lottery_passport
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
# Exact browser origins allowed to call the API with cookies: scheme + host + port,
# no path, no trailing slash. "http://86.104.82.71:8000" and "http://86.104.82.71"
# are different origins. Never "*" outside development.
CORS_ORIGINS=["http://86.104.82.71:8000","http://localhost:5173"]
# On staging and production (not demo) CORS_ORIGINS must be https (http://localhost is the only
# exception) and never "*"; the app refuses to start otherwise.

# Session cookie SameSite: lax (default, same-site or same-origin frontend) or
# none (cross-site frontend; Chrome only, needs ENVIRONMENT != development).
SESSION_COOKIE_SAMESITE=lax
# false: sign-up and scanning do not need accepted terms (test environments until the
# legal text exists; profile_complete = nickname only). Production refuses false.
TERMS_REQUIRED=true
# Public origin of the app, scheme + host only. Builds QR URLs
# (scripts.generate_codes --base-url defaults to it). Frozen once codes print.
PUBLIC_APP_ORIGIN=
# Terms of service / privacy policy pages (FX3). null (empty) until legal
# supplies real text; https required outside development.
TERMS_URL=
PRIVACY_URL=
# Feature flags, read side only (GET /config.features). mini_games is on
# because it already shipped; the rest are off until their feature ships.
FEATURE_MINI_GAMES=true
FEATURE_LEADERBOARD=false
FEATURE_VENUE_CHECKIN=false
FEATURE_DIAMONDS=false


#OTP
# Empty here: unset means send_otp just logs the code (ConsoleSmsSender) instead
# of calling Kavenegar -- the default for development and the test suite.
KAVENEGAR_OTP_API_KEY=
KAVENEGAR_TEMPLATE_LOGIN=logintorshx
KAVENEGAR_TEMPLATE_SIGNUP=signuptorshx
OTP_TTL_SECONDS=120
OTP_MAX_ATTEMPTS=5
OTP_RESEND_SECONDS=60
OTP_DAILY_LIMIT_PER_PHONE=5
# 0969 test numbers (code in the response, no SMS). Unset: on in development/demo only.
# Staging may set true; production refuses it.
# OTP_TEST_NUMBERS=
# Staging: comma-separated numbers that may receive a real SMS; everyone else gets
# 403 PHONE_NOT_ALLOWED. Empty: anyone. Production refuses a list.
OTP_ALLOWED_PHONES=
